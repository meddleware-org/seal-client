{
  "name": "@meddleware/seal-client",
  "version": "0.0.12",
  "description": "Modular Seal encryption client for Sui: a pluggable policy registry (nft-gate, time-lock, …) plus a SealController that orchestrates threshold encrypt/decrypt and SessionKey lifecycle. The on-chain half is the seal_policies Move package.",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/sealed-storage/",
  "type": "module",
  "author": "MeddleWare <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/seal-client.git"
  },
  "keywords": [
    "sui",
    "seal",
    "encryption",
    "access-control",
    "walrus",
    "web3"
  ],
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./controller": "./src/controller.ts",
    "./deployments": "./src/deployments.ts"
  },
  "scripts": {
    "gen:deployments": "node scripts/gen-deployments.mjs",
    "check:deployments": "node scripts/gen-deployments.mjs --check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "SEAL_TESTNET=1 vitest run --config vitest.integration.config.ts",
    "lint:js": "eslint .",
    "lint": "npm run lint:js"
  },
  "dependencies": {
    "@meddleware/access-gate-client": "^0.0.2"
  },
  "peerDependencies": {
    "@mysten/seal": "^1.4.17",
    "@mysten/sui": "^2.33.1"
  },
  "devDependencies": {
    "@meddleware/seal-policies-sui": "0.0.6",
    "@mysten/seal": "^1.4.17",
    "@mysten/sui": "^2.33.1",
    "@types/node": "~24.12.2",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "~5.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
