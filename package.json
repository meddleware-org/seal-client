{
  "name": "@meddleware/seal-client",
  "version": "0.0.3",
  "type": "module",
  "sideEffects": false,
  "description": "Modular Seal encryption client for Sui: a pluggable policy registry (nft-gate, time-lock, …) plus a SealController that orchestrates threshold encrypt/decrypt and SessionKey lifecycle. The on-chain half is the seal_policies Move package.",
  "author": "MeddleWare <meddleware@proton.me>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/seal-client.git"
  },
  "keywords": [
    "sui",
    "seal",
    "encryption",
    "access-control",
    "walrus",
    "web3"
  ],
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./controller": "./src/controller.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@mysten/seal": "^1.4.7",
    "@mysten/sui": "^2.28.0"
  },
  "devDependencies": {
    "@mysten/seal": "^1.4.7",
    "@mysten/sui": "^2.28.0",
    "@types/node": "~24.12.2",
    "typescript": "~6.0.3",
    "vitest": "~4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
